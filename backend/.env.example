# Copy this file to backend/.env for local development.
# Never commit backend/.env or real secrets.

# ── Application ────────────────────────────────────────────────────────────────
MAAP_APP_NAME="Modern AI Agent Platform API"
MAAP_APP_VERSION="0.1.0"
MAAP_ENVIRONMENT="development"
MAAP_DEBUG=false

# PostgreSQL database.
# These credentials are placeholders for local development only.
MAAP_DATABASE_URL="postgresql+asyncpg://maap:change-me@127.0.0.1:5432/maap"

# DeepSeek generation provider.
# Keep the real key only in backend/.env, never in this example file.
MAAP_DEEPSEEK_API_KEY=
MAAP_DEEPSEEK_BASE_URL="https://api.deepseek.com"
MAAP_DEEPSEEK_MODEL="deepseek-v4-flash"
MAAP_DEEPSEEK_TIMEOUT_SECONDS=30
MAAP_DEEPSEEK_MAX_RETRIES=2

# Voyage AI knowledge embeddings and reranking.
MAAP_VOYAGE_API_KEY=
MAAP_VOYAGE_BASE_URL="https://api.voyageai.com/v1"
MAAP_VOYAGE_MODEL="voyage-4-large"
MAAP_VOYAGE_RERANK_MODEL="rerank-2.5"
MAAP_VOYAGE_TIMEOUT_SECONDS=30.0
MAAP_VOYAGE_MAX_RETRIES=2
MAAP_VOYAGE_RETRY_BASE_SECONDS=0.5
MAAP_EMBEDDING_DIMENSION=1024
MAAP_RETRIEVAL_CANDIDATE_COUNT=20

# ── File Processing ────────────────────────────────────────────────────────────
# Maximum size of a single uploaded file, in bytes (default: 20 MB).
MAAP_MAX_UPLOAD_SIZE_BYTES=20971520

# Maximum number of pages accepted from a PDF document.
MAAP_MAX_PDF_PAGES=500

# Shared source-file storage for API and ingestion workers.
MAAP_UPLOAD_STORAGE_ROOT=".data/uploads"

# Durable PostgreSQL-backed ingestion worker.
MAAP_INGESTION_WORKER_POLL_SECONDS=2
MAAP_INGESTION_JOB_LOCK_TIMEOUT_SECONDS=600
MAAP_INGESTION_JOB_MAX_ATTEMPTS=3

# ── Chunking ───────────────────────────────────────────────────────────────────
# Target character count per chunk. Must be greater than chunk_overlap.
MAAP_CHUNK_SIZE=1000

# Characters shared between consecutive chunks. Must be less than chunk_size.
MAAP_CHUNK_OVERLAP=200

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Maximum chunks sent to the embedding provider per request.
MAAP_EMBEDDING_BATCH_SIZE=8

# ── Retrieval ──────────────────────────────────────────────────────────────────
# Default number of chunks returned by a similarity search.
MAAP_RETRIEVAL_TOP_K=5

# Minimum cosine similarity score for a chunk to be included in results (0.0–1.0).
MAAP_RETRIEVAL_MIN_SIMILARITY=0.5

# Maximum retrieved characters inserted into one generation request.
MAAP_RAG_MAX_CONTEXT_CHARS=12000

# ── Admin Authentication ───────────────────────────────────────────────────────
# HS256 signing key for admin JWT access tokens.
# Must be at least 32 random characters in staging and production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MAAP_JWT_SECRET_KEY=

# Lifetime of the short-lived admin access token, in minutes (default: 15).
MAAP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Lifetime of the long-lived admin refresh token, in days (default: 7).
MAAP_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to false once all admin callers have migrated from X-Admin-Key to JWT.
MAAP_ADMIN_LEGACY_KEY_ENABLED=true

# Shared Redis for distributed login and Widget rate limiting.
MAAP_REDIS_URL="redis://127.0.0.1:6379/0"
MAAP_ADMIN_LOGIN_RATE_LIMIT_PER_ACCOUNT=5
MAAP_ADMIN_LOGIN_RATE_LIMIT_PER_IP=20
MAAP_ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Trust forwarding headers only from explicitly configured proxy networks.
# Pydantic tuple syntax in environment variables uses a JSON array.
MAAP_TRUSTED_PROXY_CIDRS='[]'

# Browser Widget JWT. Use a different random value from the Admin JWT key.
MAAP_WIDGET_JWT_SECRET_KEY=
MAAP_WIDGET_TOKEN_LIFETIME_SECONDS=600
MAAP_WIDGET_BOOTSTRAP_RATE_LIMIT_PER_WIDGET=60
MAAP_WIDGET_BOOTSTRAP_RATE_LIMIT_PER_IP=300
MAAP_WIDGET_BOOTSTRAP_RATE_LIMIT_WINDOW_SECONDS=60
MAAP_WIDGET_CHAT_RATE_LIMIT_PER_SESSION=30
MAAP_WIDGET_CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ── Argon2id Password Hashing ──────────────────────────────────────────────────
# Time cost (number of iterations). OWASP minimum: 2.
MAAP_ARGON2_TIME_COST=2

# Memory usage in KiB. OWASP minimum: 19456 (19 MiB).
MAAP_ARGON2_MEMORY_COST=19456

# Degree of parallelism (number of threads).
MAAP_ARGON2_PARALLELISM=1
