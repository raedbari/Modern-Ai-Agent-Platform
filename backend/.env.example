# Copy this file to backend/.env for local development.
# Never commit backend/.env or real secrets.
MAAP_APP_NAME="Modern AI Agent Platform API"
MAAP_APP_VERSION="0.1.0"
MAAP_ENVIRONMENT="development"
MAAP_DEBUG=false
# DeepSeek generation provider.
# Keep the real key only in backend/.env, never in this example file.
MAAP_DEEPSEEK_API_KEY=
MAAP_DEEPSEEK_BASE_URL="https://api.deepseek.com"
deepseek_model: str = "deepseek-chat"MAAP_DEEPSEEK_TIMEOUT_SECONDS=30
MAAP_DEEPSEEK_MAX_RETRIES=2

# Local Ollama embedding provider.
MAAP_OLLAMA_BASE_URL="http://127.0.0.1:11434"
MAAP_OLLAMA_EMBEDDING_MODEL="qwen3-embedding:0.6b"
MAAP_EMBEDDING_DIMENSION=1024
MAAP_OLLAMA_TIMEOUT_SECONDS=30

# Database
# For local development, use the default PostgreSQL connection.
# In production, set to your actual database URL.
MAAP_DATABASE_URL="postgresql+asyncpg://maap:maap@localhost:5432/maap_dev"
MAAP_DATABASE_POOL_SIZE=5
MAAP_DATABASE_MAX_OVERFLOW=10
MAAP_DATABASE_ECHO=false