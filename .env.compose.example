# Copy to .env.compose or run scripts/local-up.ps1 to generate it.
# Never commit .env.compose.

MAAP_POSTGRES_USER=maap
MAAP_POSTGRES_PASSWORD=replace-with-a-long-random-password
MAAP_POSTGRES_DB=maap
MAAP_POSTGRES_PORT=5433
MAAP_API_PORT=8000
MAAP_RUNTIME_ENVIRONMENT=development
MAAP_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
MAAP_VOYAGE_API_KEY=replace-with-your-voyage-api-key
MAAP_ADMIN_API_KEY=change-me-dev-admin-key
MAAP_JWT_SECRET_KEY=change-me-dev-jwt-secret-at-least-32-characters
MAAP_WIDGET_JWT_SECRET_KEY=change-me-dev-widget-secret-at-least-32-characters
POSTGRES_DB=maap
POSTGRES_USER=maap
